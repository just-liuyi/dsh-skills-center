{
  "name": "@local/dsh-skills-center",
  "version": "1.9.5",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "test:github": "node scripts/verify-github.mjs",
    "test:directory": "node scripts/verify-directory.mjs"
  },
  "description": "能力中心：统一管理 Skill、MCP、提示词、工具与 npm 组件更新 · Capability Center: manage skills, MCP servers, prompts, tools and npm component updates",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "skills-sources.js",
    "components.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
