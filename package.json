{
  "name": "@local/dsh-switch",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "技能中心：左侧栏统一管理 Skill、MCP 与提示词注入 · Skills Center: manage skills, MCP servers and prompt injections from one sidebar entry",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
