{
  "name": "@local/dsh-skills-center",
  "version": "1.8.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "test:github": "node scripts/verify-github.mjs",
    "test:directory": "node scripts/verify-directory.mjs"
  },
  "description": "技能中心：搜索 skills.sh、管理本地与在线 Skill、安装更新、MCP 和提示词 · Skills Center: search skills.sh, manage local and online skills, installs, updates, MCP servers and prompts",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "skills-sources.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
